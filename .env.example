# ── Vauntico Scan Public ──────────────────────────────────────────────
# Copy this file to .env and fill in the values you want to use.

# ── Base URL for endpoint leak probing ─────────────────────────────────
# The root URL of the web application you want to test for anonymous leaks.
# VAUNTICO_BASE_URL=https://your-app.com

# ── Leak probe endpoints (comma-separated) ──────────────────────────────
# Defaults to a standard set of sensitive API paths if not provided.
# VAUNTICO_LEAK_ENDPOINTS=/api/admin/approve,/api/trust/certificate/test

# ── Supabase Live RLS Verification ──────────────────────────────────────
# These are optional. When set, vauntico-scan will connect directly to
# your Supabase project and query pg_policies for live RLS analysis.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...