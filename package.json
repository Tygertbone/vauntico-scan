    "table": "^6.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "supabase",
    "rls",
    "security",
    "audit",
    "sql",
    "leak-detection",
    "cli",
    "vauntico"
